# Forex Signal Engine - environment template
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Phase 8 production safety & persistence
# ---------------------------------------------------------------------------

# Optional durable state root. Defaults to <project>/.data.
# Use a persistent volume/path in deployments where the application filesystem
# is otherwise ephemeral.
# FSE_DATA_DIR=C:\fse-data
# FSE_DATA_DIR=/var/lib/fse

# Maintenance mode blocks manual + automatic scanner execution while keeping
# health/recovery endpoints available. Restart the Node process after changing.
FSE_MAINTENANCE_MODE=false

# Optional strict readiness gates. Recommended for a staged production-like
# Paper deployment after an ACTIVE strategy release exists.
FSE_REQUIRE_ACTIVE_RELEASE=false
FSE_REQUIRE_LIVE_MARKET_DATA=false

# Optional individual file overrides retained for compatibility.
# FSE_PAPER_STORE_PATH=
# FSE_FORWARD_VALIDATION_STORE_PATH=

# ---------------------------------------------------------------------------
# Market data runtime
# ---------------------------------------------------------------------------

# Safe default for tests/offline development:
MARKET_DATA_PROVIDER=mock

# Optional comma-separated scanner universe override.
# Useful for staged live acceptance before enabling all configured pairs.
# SCANNER_SYMBOLS=EURUSD

# Primary free live-data path: MetaTrader 5 local bridge
# MARKET_DATA_PROVIDER=mt5
# MT5_BRIDGE_URL=http://127.0.0.1:8765
# MT5_REQUEST_TIMEOUT_MS=5000

# Optional OANDA provider
# MARKET_DATA_PROVIDER=oanda
# OANDA_ENVIRONMENT=practice
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_BASE_URL=https://api-fxpractice.oanda.com
# OANDA_REQUEST_TIMEOUT_MS=12000

# Legacy generic key placeholder.
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Future phases
# ---------------------------------------------------------------------------

DATABASE_URL=
ECONOMIC_CALENDAR_API_KEY=


# ---------------------------------------------------------------------------
# Phase 9 transactional infrastructure
# ---------------------------------------------------------------------------

# Keep "local" for Phase 8-compatible single-node development.
# Use "remote" for multi-instance/shared-state deployments.
FSE_TX_STORE_MODE=local

# Strict readiness gate: when true, LOCAL mode is BLOCKED.
FSE_REQUIRE_SHARED_TX_STORE=false

# PostgREST/Supabase-style base URL exposing the Phase 9 RPC functions.
# Example: https://<project>.supabase.co/rest/v1
# FSE_TX_STORE_URL=
# FSE_TX_STORE_TOKEN=

# Remote request timeout and scanner lease TTL.
FSE_TX_STORE_TIMEOUT_MS=8000
FSE_TX_LEASE_TTL_MS=180000

# Optional stable instance identity. Defaults to hostname:pid.
# FSE_INSTANCE_ID=fse-node-a


# ---------------------------------------------------------------------------
# Phase 10 broker integration & live execution safety
# ---------------------------------------------------------------------------

# Safe defaults: broker integration is OFF and live transmission is disabled.
# Modes:
#   off    = no broker execution processing
#   shadow = record broker-intent safety decisions, no external order
#   live   = eligible for real broker submission only when EVERY live gate passes
FSE_BROKER_MODE=off
FSE_BROKER_PROVIDER=shadow
FSE_LIVE_EXECUTION_ENABLED=false
# Independent hard stop. Defaults true even when omitted.
# Set false only during an explicitly controlled live window.
FSE_LIVE_EMERGENCY_STOP=true

# Required for every control mutation (arm/disarm/kill-switch).
# Keep server-side only. Never expose as NEXT_PUBLIC_*.
# FSE_LIVE_APPROVAL_SECRET=

# Explicit allowlist. Empty list blocks every LIVE order.
# FSE_LIVE_ALLOWED_SYMBOLS=EURUSD

# Hard live risk rails. These are independent of strategy configuration.
FSE_LIVE_MAX_RISK_PERCENT=0.25
FSE_LIVE_MAX_LOT=0.10
FSE_LIVE_MAX_ORDERS_PER_CYCLE=1
FSE_LIVE_MAX_OPEN_POSITIONS=1
FSE_LIVE_MAX_EQUITY_DRAWDOWN_PERCENT=2
FSE_LIVE_BLOCK_SAME_SYMBOL_POSITION=true

# Arm approvals expire and have a bounded order budget.
FSE_LIVE_ARM_MAX_MINUTES=10
FSE_LIVE_ARM_MAX_ORDERS=1
FSE_LIVE_EXECUTION_LEASE_MS=30000

# MT5 trade bridge. Market-data MT5 can remain read-only without these.
# Both FSE and bridge must independently opt in.
# FSE_BROKER_PROVIDER=mt5
# MT5_TRADE_BRIDGE_ENABLED=true
# MT5_TRADE_BRIDGE_TOKEN=<same secret on bridge host>
# MT5_TRADE_MAGIC=105610
# MT5_TRADE_HISTORY_DAYS=14
# MT5_TRADE_BRIDGE_TOKEN is read by the Python bridge.
# MT5_TRADE_BRIDGE_TOKEN must match this app-side variable:
# MT5_TRADE_BRIDGE_TOKEN=<server-only token>
MT5_TRADE_REQUEST_TIMEOUT_MS=8000
MT5_TRADE_MAX_DEVIATION_POINTS=20


# ---------------------------------------------------------------------------
# Phase 11 realtime alerting & notifications
# ---------------------------------------------------------------------------

# Master switch. Safe default is OFF.
FSE_ALERTS_ENABLED=false

# Lifecycle alerts. Near-execute / execute / invalidated are recommended;
# WATCH and BLOCKED are noisier and default OFF.
FSE_ALERT_WATCH=false
FSE_ALERT_NEAR_EXECUTE=true
FSE_ALERT_EXECUTE=true
FSE_ALERT_BLOCKED=false
FSE_ALERT_INVALIDATED=true

# Deterministic NEAR_EXECUTE threshold. The engine output must also be FRESH,
# setup ARMED, trigger WAITING, risk approved, RR valid, and have no hard veto.
FSE_ALERT_NEAR_EXECUTE_BIAS_SCORE=60
FSE_ALERT_NEAR_EXECUTE_SETUP_SCORE=70
FSE_ALERT_NEAR_EXECUTE_TRIGGER_SCORE=50
FSE_ALERT_NEAR_EXECUTE_MIN_RR=1.5

# Dedup/retry controls.
FSE_ALERT_COOLDOWN_SECONDS=300
FSE_ALERT_MAX_ATTEMPTS=5
FSE_ALERT_RETRY_BASE_MS=5000
FSE_ALERT_REQUEST_TIMEOUT_MS=8000
FSE_ALERT_WORKER_INTERVAL_MS=5000
FSE_ALERT_TIME_ZONE=Asia/Makassar

# Required only for manual retry through POST /api/notifications.
# Keep server-side only.
# FSE_ALERT_ADMIN_SECRET=

# Telegram Bot API.
FSE_TELEGRAM_ENABLED=false
# FSE_TELEGRAM_BOT_TOKEN=
# FSE_TELEGRAM_CHAT_ID=

# WhatsApp Cloud API.
FSE_WHATSAPP_ENABLED=false
# FSE_WHATSAPP_ACCESS_TOKEN=
# FSE_WHATSAPP_PHONE_NUMBER_ID=
# FSE_WHATSAPP_RECIPIENT=
# Set explicitly to the Graph API version supported by your Meta app.
# Example format: vXX.X
# FSE_WHATSAPP_GRAPH_API_VERSION=
# Optional approved template mode for proactive alerts. The template should
# contain one body variable that receives the formatted FSE alert text.
# FSE_WHATSAPP_TEMPLATE_NAME=
FSE_WHATSAPP_TEMPLATE_LANGUAGE=id
