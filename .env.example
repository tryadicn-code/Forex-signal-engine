# Forex Signal Engine - environment template
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

# PostgreSQL connection string (used once Prisma is introduced)
DATABASE_URL=

# Market data provider (e.g. OANDA / Twelve Data / Alpha Vantage)
MARKET_DATA_API_KEY=

# Economic calendar provider (used later; not required in Phase 1)
ECONOMIC_CALENDAR_API_KEY=
