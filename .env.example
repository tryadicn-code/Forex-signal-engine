# Forex Signal Engine - environment template
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Market data runtime
# ---------------------------------------------------------------------------

# Safe default for tests/offline development:
MARKET_DATA_PROVIDER=mock

# Optional comma-separated scanner universe override.
# Useful for staged live acceptance before enabling all configured pairs.
# SCANNER_SYMBOLS=EURUSD

# Primary free live-data path: MetaTrader 5 local bridge
# MARKET_DATA_PROVIDER=mt5
# MT5_BRIDGE_URL=http://127.0.0.1:8765
# MT5_REQUEST_TIMEOUT_MS=5000

# Optional OANDA provider
# MARKET_DATA_PROVIDER=oanda
# OANDA_ENVIRONMENT=practice
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_BASE_URL=https://api-fxpractice.oanda.com
# OANDA_REQUEST_TIMEOUT_MS=12000

# Legacy generic key placeholder.
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Future phases
# ---------------------------------------------------------------------------

DATABASE_URL=
ECONOMIC_CALENDAR_API_KEY=
