# Forex Signal Engine - environment template
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

# ---------------------------------------------------------------------------
# Market data runtime
# ---------------------------------------------------------------------------

# Safe default for tests/offline development:
MARKET_DATA_PROVIDER=mock

# Switch to OANDA market data:
# MARKET_DATA_PROVIDER=oanda
# OANDA_ENVIRONMENT=practice
# OANDA_API_TOKEN=
# OANDA_ACCOUNT_ID=
#
# Optional overrides:
# OANDA_BASE_URL=https://api-fxpractice.oanda.com
# OANDA_REQUEST_TIMEOUT_MS=12000

# Legacy generic key placeholder. Not used by the OANDA adapter.
MARKET_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Future phases
# ---------------------------------------------------------------------------

# PostgreSQL connection string (used once persistence is introduced)
DATABASE_URL=

# Economic calendar provider (not required yet)
ECONOMIC_CALENDAR_API_KEY=
